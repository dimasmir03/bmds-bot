TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
DATABASE_URL=postgresql+asyncpg://bmds:{{ postgres_password | urlencode }}@postgres:5432/bmds
POSTGRES_PASSWORD={{ postgres_password }}
REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY={{ admin_api_key }}
IMAGE_PROVIDER={{ image_provider | default('mock') }}
STORAGE_ROOT=/app/storage
MAX_IMAGE_SIZE_MB=20
LOG_LEVEL=INFO
MOCK_PROCESSING_DELAY_SECONDS=2
MAX_CONCURRENT_JOBS=1
RATE_LIMIT_JOBS=5
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_QUEUE_NAME=image_jobs
HF_TOKEN={{ hf_token | default('') }}
HF_MODEL_ID={{ hf_model_id | default('black-forest-labs/FLUX.2-klein-9B') }}
MODEL_DEVICE=cuda
MODEL_CPU_OFFLOAD={{ model_cpu_offload | default(false) | lower }}
MODEL_QUANTIZATION={{ model_quantization | default('none') }}
MODEL_NUM_INFERENCE_STEPS=4
MODEL_GUIDANCE_SCALE=1.0
MODEL_MAX_IMAGE_SIDE=1024

