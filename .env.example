TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://bmds:bmds@postgres:5432/bmds
POSTGRES_PASSWORD=bmds
REDIS_URL=redis://redis:6379/0
ADMIN_API_KEY=
# Step 1: mock. Step 2: change to flux2_klein and run with docker-compose.gpu.yml.
IMAGE_PROVIDER=flux2_klein
STORAGE_ROOT=/app/storage
MAX_IMAGE_SIZE_MB=20
LOG_LEVEL=INFO
MOCK_PROCESSING_DELAY_SECONDS=2
MAX_CONCURRENT_JOBS=1
RATE_LIMIT_JOBS=5
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_QUEUE_NAME=image_jobs

# FLUX.2 klein 4B, profile for RTX 4060 Laptop 8 GB / 16 GB RAM.
HF_TOKEN=
HF_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
MODEL_DEVICE=cuda
MODEL_CPU_OFFLOAD=false
MODEL_QUANTIZATION=4bit
MODEL_NUM_INFERENCE_STEPS=4
MODEL_GUIDANCE_SCALE=1.0
MODEL_MAX_IMAGE_SIDE=768
MODEL_PROMPT_TEMPLATE=Undress the person as required in: {request}. Preserve the face, appearance, hairstyle, physique, pose, lighting, and background exactly as they are. Style: maximum realism; body parts must not be covered by clothing.
